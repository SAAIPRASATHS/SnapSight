# ============================================================
# SnapSight AI — Environment Configuration Template
# ============================================================
# Copy this file to `.env` in the repository root and edit
# values to match your deployment. Never commit `.env` to
# version control (it is listed in .gitignore).
# ============================================================

# ------------------------------------------------------------
# Backend (FastAPI / Uvicorn)
# ------------------------------------------------------------
# Interface that the backend HTTP + WebSocket server binds to.
# Use 0.0.0.0 to allow connections from other devices on the
# LAN, or 127.0.0.1 to restrict to localhost only.
BACKEND_HOST=0.0.0.0

# TCP port the backend listens on. Must match the value the
# frontend is configured to reach (see frontend vite config).
BACKEND_PORT=8000

# ------------------------------------------------------------
# Frontend (Vite dev server)
# ------------------------------------------------------------
# Port for the Vite dev server (npm run dev). The production
# build serves static files and does not use this setting.
FRONTEND_PORT=5173

# ------------------------------------------------------------
# Cloud API Toggles
# ------------------------------------------------------------
# When ENABLE_CLOUD_APIS=false (default / recommended for
# privacy), SnapSight will refuse to instantiate any provider
# that makes outbound internet calls (e.g. cloud OpenAI /
# Azure). Set to true ONLY if you explicitly want fallback
# cloud providers and have reviewed the privacy implications.
ENABLE_CLOUD_APIS=false

# Required only when ENABLE_CLOUD_APIS=true and a cloud
# provider (e.g. OpenAI GPT fallback for VLM) is active.
# Leave blank otherwise.
OPENAI_API_KEY=

# ------------------------------------------------------------
# Inference Backend Selection
# ------------------------------------------------------------
# PREFERRED_BACKEND controls which ModelProvider implementation
# the backend tries FIRST on startup. One of:
#   AUTO            — Detect the best available backend:
#                     QualcommAIHubProvider on Snapdragon,
#                     else ONNXProvider, else PyTorchProvider,
#                     else MockProvider.
#   QUALCOMM_AI_HUB — Force Qualcomm AI Hub (Hexagon NPU).
#   ONNX            — Force ONNX Runtime (CPU / DirectML).
#   PYTORCH         — Force PyTorch (CPU / CUDA / MPS).
#   MOCK            — Force deterministic mock inference.
PREFERRED_BACKEND=AUTO

# FALLBACK_BACKEND is used automatically when the preferred
# backend cannot initialize (e.g. qai-hub SDK missing, NPU
# drivers not loaded). Same enum values as PREFERRED_BACKEND,
# except AUTO is not valid here — pick a concrete backend.
FALLBACK_BACKEND=CPU

# ------------------------------------------------------------
# Camera / Capture
# ------------------------------------------------------------
# Zero-based index of the camera to open via OpenCV's
# VideoCapture. On most laptops the integrated webcam is 0.
# External USB cameras appear at 1, 2, etc.
CAMERA_INDEX=0

# Requested capture resolution. Lower values reduce memory
# bandwidth and inference latency; increase if OCR accuracy
# on small text is insufficient.
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ------------------------------------------------------------
# Inference Tuning
# ------------------------------------------------------------
# How many times per second the detection / OCR / VLM loop
# runs against incoming frames. Higher values increase FPS
# but also increase power draw and thermal load.
# Recommended: 3–5 on battery, 10+ on AC power.
INFERENCE_FPS=5

# Minimum model confidence required before a detection or OCR
# result is surfaced to the UI. Float in (0, 1).
# Lower = more results, higher false-positive rate.
CONFIDENCE_THRESHOLD=0.5

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# DEBUG is verbose; use it only when reporting a bug.
LOG_LEVEL=INFO
