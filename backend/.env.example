# SnapSight AI Backend environment template
# Copy to .env and adjust values as needed.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# mock | onnx | pytorch | qaihub
PREFERRED_BACKEND=mock
FALLBACK_BACKEND=mock

CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

INFERENCE_FPS=10
CONFIDENCE_THRESHOLD=0.5

# Set to True only if you understand network/token implications
ENABLE_CLOUD_APIS=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
